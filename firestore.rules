rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per player, keyed by their anonymous Firebase UID.
    // Anyone signed in (anonymously) can read any profile (needed to show a
    // friend's progress/online status), but can only create/fully edit
    // their own document. A second, narrower rule lets any signed-in player
    // append themselves to *another* player's friendIDs array only — that's
    // what makes FriendsService.addFriend's mutual batch write legal
    // without opening the rest of a stranger's profile to editing.
    match /players/{playerID} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == playerID;
      allow update: if request.auth != null && (
        request.auth.uid == playerID ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendIDs'])
      );
      allow delete: if false;
    }

    // 8-digit code -> playerID lookup table. Anyone signed in can look a
    // code up; only the owning player can create their own code mapping,
    // and it's immutable afterwards (codes never change hands or get
    // edited).
    match /friendCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.playerID == request.auth.uid;
      allow update, delete: if false;
    }

    // Global player-name reservation: one doc per lowercased name ->
    // { playerID, displayName, claimedAt } — see PlayerNameService. Anyone
    // signed in can read (to check availability); only the claiming player
    // may create or update their own reservation (an update is just this
    // same player idempotently re-affirming a name they already own — the
    // transaction client-side already refuses to touch anyone else's), and
    // a name is never released once claimed.
    match /playerNames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.playerID == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.playerID == request.auth.uid &&
        request.resource.data.playerID == request.auth.uid;
      allow delete: if false;
    }

    // Weekly World Boss leaderboard: one entry per player per week, keyed by
    // their anonymous Firebase UID under a weekID document (e.g.
    // "2026-W39" — see WorldBossSystem.weekID). Anyone signed in can read
    // every entry (that's the leaderboard itself); a player can only ever
    // write their own entry, and only a running damage total, never anyone
    // else's rank.
    match /worldBossLeaderboard/{weekID}/entries/{playerID} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == playerID &&
        request.resource.data.damage is int && request.resource.data.damage >= 0;
      allow delete: if false;
    }
  }
}
