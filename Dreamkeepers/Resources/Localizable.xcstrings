          }
        }
      }
    },
    "Claim all 7 days of a Login Streak.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hole dir alle 7 Tage einer Login-Serie ab."
          }
        }
      }
    },
    "Claim the gold and gem rewards on every tier you've already reached — no rush, they stay unlocked for the rest of the season.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol dir die Gold- und Edelstein-Belohnungen jeder bereits erreichten Stufe ab — kein Stress, sie bleiben für den Rest der Saison freigeschaltet."
          }
        }
      }
    },
