    "Refracts a portion of incoming force.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bricht einen Teil der einwirkenden Kraft."
          }
        }
      }
    },
    "Refracts every sound in the cavern into a faint, discordant chime.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bricht jeden Klang der Höhle zu einem leisen, schrägen Klingeln."
          }
        }
      }
    },
    "Releases a faint cloud of spores whenever it's startled.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt bei Schreck eine feine Sporenwolke frei."
          }
        }
      }
    },
    "Replay the battle for the same rewards, or skip straight to the payout.": {
      "localizations": {
        "de": {
          "stringUnit": {
