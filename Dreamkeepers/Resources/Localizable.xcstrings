    "Stands guard at the border between dream and stars.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steht Wache an der Grenze zwischen Traum und Sternen."
          }
        }
      }
    },
    "Stands where a mountain-sized dream slowly finished melting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steht dort, wo ein bergegroßer Traum langsam zu Ende geschmolzen ist."
