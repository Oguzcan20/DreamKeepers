        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Amulett"
          }
        }
      }
    },
    "Chases the tail of an actual comet through the dream sky and usually wins.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jagt den Schweif eines echten Kometen über den Traumhimmel – und gewinnt meist."
          }
        }
      }
    },
    "Chest of Gems": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Truhe Edelsteine"
          }
        }
      }
    },
    "Churns the water into a squall wherever it swims.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wühlt das Wasser zu einer Bö auf, wo immer es schwimmt."
          }
        }
      }
    },
    "Circles the burning ruins on wings of drifting ember.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umkreist die brennenden Ruinen auf Flügeln aus treibender Glut."
          }
        }
      }
    },
    "Circles the star temple ruins on wings woven from old constellations.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umkreist die Ruinen des Sterntempels auf Flügeln aus alten Sternbildern."
          }
        }
      }
    },
    "Circles the watching moon on wings that never cast a shadow.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umkreist den wachenden Mond auf Flügeln, die nie einen Schatten werfen."
          }
        }
      }
    },
