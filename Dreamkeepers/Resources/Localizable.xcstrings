    "Tap a Dreamkeeper to deploy or bench them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe einen Dreamkeeper an, um ihn einzusetzen oder auf die Bank zu setzen."
          }
        }
      }
    },
    "Tap a Dreamkeeper to view stats and fusion.": {
      "localizations": {
