    "Summoned gear joins your Inventory, sized to your current stage.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschworene Ausrüstung landet in deinem Inventar, passend zu deiner aktuellen Stufe."
