    "Sign in to keep your account ready for friends and cross-device play.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich an, damit dein Konto bereit für Freunde und geräteübergreifendes Spielen ist."
          }
