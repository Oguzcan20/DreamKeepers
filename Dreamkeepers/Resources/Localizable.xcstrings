          }
        }
      }
    },
    "Stalks the hedgerows of a garden dream no one remembers planting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schleicht durch die Hecken eines Gartentraums, an dessen Pflanzung sich niemand erinnert."
