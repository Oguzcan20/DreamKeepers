    "Steps between floating ruin-fragments as if they were solid ground.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreitet zwischen schwebenden Ruinenfragmenten, als wären sie fester Boden."
          }
        }
      }
    },
    "Steps leave no print — the eclipse realm forgets it was ever there.": {
      "localizations": {
        "de": {
          "stringUnit": {
