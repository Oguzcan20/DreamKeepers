    "Bites clean through cooled rock crust in search of the wastes' heat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beißt sich glatt durch abgekühlte Gesteinskruste auf der Suche nach der Hitze der Ödnis."
          }
        }
      }
    },
    "Bites through the thick canopy vines with practiced ease.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beißt sich mit geübter Leichtigkeit durch die dicken Ranken des Blätterdachs."
          }
