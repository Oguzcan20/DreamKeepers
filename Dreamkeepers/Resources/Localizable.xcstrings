    },
    "VIP Pass": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VIP-Pass"
          }
        }
      }
    },
    "Vanishes into brush and strikes from an angle no one expects.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschwindet im Gestrüpp und schlägt aus einem Winkel zu, den niemand erwartet."
          }
        }
      }
    },
    "Vast volcanoes and lakes of lava beneath a sky choked with ash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewaltige Vulkane und Lavaseen unter einem von Asche erstickten Himmel."
          }
        }
      }
    },
    "Vault of Gems": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tresor voller Edelsteine"
          }
        }
      }
    },
    "Victory!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieg!"
          }
        }
      }
    },
    "View %@ details": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Details ansehen"
          }
        }
      }
    },
    "Visit the Shop": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besuche den Shop"
          }
        }
      }
    },
    "Visit the Shop 3 Times": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besuche den Shop 3-mal"
          }
        }
      }
    },
    "Waits beneath the tunnel floor for something to walk overhead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet unter dem Tunnelboden, bis etwas darüber läuft."
          }
        }
      }
    },
    "Wanders the broken buildings, howling at a moon no one else remembers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandert durch die zerbrochenen Gebäude und heult einen Mond an, an den sich sonst niemand erinnert."
          }
        }
      }
    },
    "Watch Ad": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbung ansehen"
          }
        }
      }
    },
    "Watches from branches that exist only under a full moon.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht von Ästen, die nur bei Vollmond existieren."
          }
        }
      }
    },
    "Weak Against": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwach gegen"
          }
        }
      }
    },
    "Weapon": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Waffe"
          }
        }
      }
    },
    "Wears a coat of drifting ash over skin still smoldering beneath.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trägt einen Mantel aus treibender Asche über Haut, die darunter noch schwelt."
          }
        }
      }
    },
    "Wears a crown grown from a forest's oldest, gentlest dream.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trägt eine Krone, gewachsen aus dem ältesten, sanftesten Traum eines Waldes."
          }
        }
      }
    },
    "Wears the shape of a forgotten dream, hollow at the center.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trägt die Form eines vergessenen Traums, hohl in der Mitte."
          }
        }
      }
    },
    "Weekly Challenge": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wöchentliche Herausforderung"
          }
        }
      }
    },
    "Whispering Meadow": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flüsternde Wiese"
          }
        }
      }
    },
    "Win a battle without taking damage.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewinne einen Kampf ohne Schaden zu nehmen."
          }
        }
      }
    },
    "Win battles to earn Season XP — bosses grant more. Each tier unlocks a Free reward automatically; tap the arrow on a tier to claim it, or claim the matching Premium reward too once unlocked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewinne Kämpfe, um Saison-EP zu verdienen — Bosse geben mehr. Jede Stufe schaltet automatisch eine kostenlose Belohnung frei; tippe auf den Pfeil, um sie abzuholen, oder hol dir bei freigeschaltetem Premium auch die passende Premium-Belohnung."
          }
        }
      }
    },
    "World %lld Completed!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welt %lld abgeschlossen!"
          }
        }
      }
    },
    "Worn by %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Getragen von %@"
          }
        }
      }
    },
    "Wraps itself in hardy brambles, growing bolder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hüllt sich in zähe Dornranken und wird mutiger."
          }
        }
      }
    },
    "Wraps the foe in a crushing spiral of water.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umschlingt den Gegner in einer erdrückenden Wasserspirale."
          }
        }
      }
    },
    "You've cleared every known dream. More worlds are on the way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast jeden bekannten Traum bezwungen. Weitere Welten sind unterwegs."
          }
        }
      }
    },
    "You've conquered all 100 floors of the Endless Trial.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast alle 100 Stufen des Turms der Unendlichkeit bezwungen."
          }
        }
      }
    },
    "You've used all your Endless Trial attempts for today. Come back tomorrow!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast alle deine heutigen Turm-Versuche aufgebraucht. Komm morgen wieder!"
          }
        }
      }
    },
    "Young and playful, riding the abyss's slow deep currents.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jung und verspielt, reitet auf den langsamen Tiefenströmungen des Abgrunds."
          }
        }
      }
    },
    "Young, but already larger than most fully grown Bloom creatures.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jung, aber bereits größer als die meisten ausgewachsenen Bloom-Wesen."
          }
        }
      }
    },
    "Young, but already tougher than it looks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jung, aber schon zäher, als es aussieht."
          }
